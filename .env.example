# Copy this file to .env and fill in real values.
# The backend reads these on startup; missing OPENAI_API_KEY will cause /ask to 500.

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
# Optional override (defaults to gpt-6-luna, OpenAI's listed
# replacement for the deprecated gpt-4o-mini)
# OPENAI_MODEL=gpt-6-luna

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=aws_costs